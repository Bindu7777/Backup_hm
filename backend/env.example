# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration
SMTP_HOST=mail.bindu.tconnecthub.com
SMTP_PORT=465
SMTP_USER=test@bindu.tconnecthub.com
SMTP_PASSWORD=your_actual_email_password_here

# Optional: Alternative Email Services
# SENDGRID_API_KEY=your_sendgrid_api_key
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# RESEND_API_KEY=your_resend_api_key

# Supabase Credentials
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Momo Bot Security & Verification
MOMO_ACCESS_SECRET=MomoAdmin2026!
# Or hashed secret:
# MOMO_ACCESS_SECRET_HASH=your_scrypt_or_pbkdf2_hash_here
MOMO_ENCRYPTION_KEY=your_aes_256_encryption_key_here
SESSION_SECRET=your_secure_session_secret

# Official Meta Instagram Platform Integration
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=happy_moments_momo_verify_token

# Website Analytics (Google Analytics 4 Data API - Optional)
GA4_PROPERTY_ID=your_ga4_property_id
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
